---
import { Code, Tabs, TabItem } from "@astrojs/starlight/components";

interface Props {
  baseFilePath: string;
  codeFiles?: Record<string, string>;
}

const {
  baseFilePath,
  codeFiles = import.meta.glob<string>(
    '/src/content/docs/**/*.{cs,fs,vb}', {
      eager: true,
      query: '?raw',
      import: 'default'
    }
  ),
} = Astro.props;

function tryGetFile(fileExtension: string): string | null {
  const pageDirectory = Astro.url.pathname.endsWith('/') ? Astro.url.pathname : `${Astro.url.pathname}/`;
  const filePathWithoutExtension = `/src/content/docs${pageDirectory}${baseFilePath}`;
  const fullPath = `${filePathWithoutExtension}${fileExtension}`;

  return codeFiles[fullPath] ?? null;
}

function tryGetFileAndWarnIfBlank(fileExtension: string): string | null {
  const code = tryGetFile(fileExtension);

  if (code !== null && code.trim() === '') {
    console.warn(`CodeTabs skipped the empty ${fileExtension} file for "${baseFilePath}" on page ${Astro.url.pathname}`);
    return '';
  }

  return code;
}

const cSharpCode = tryGetFileAndWarnIfBlank('.cs');
const fSharpCode = tryGetFileAndWarnIfBlank('.fs');
const visualBasicCode = tryGetFileAndWarnIfBlank('.vb');

if (cSharpCode === null && fSharpCode === null && visualBasicCode === null) {
  throw new Error(`CodeTabs found no .cs, .fs or .vb files for "${baseFilePath}" on page ${Astro.url.pathname}`);
}
---

<Tabs syncKey="code-language">
  {cSharpCode && (
    <TabItem label="C#">
      <Code code={cSharpCode} lang="csharp" title="" />
    </TabItem>
  )}
  {fSharpCode && (
    <TabItem label="F#">
      <Code code={fSharpCode} lang="fsharp" title="" />
    </TabItem>
  )}
  {visualBasicCode && (
    <TabItem label="Visual Basic">
      <Code code={visualBasicCode} lang="vb" title="" />
    </TabItem>
  )}
</Tabs>
